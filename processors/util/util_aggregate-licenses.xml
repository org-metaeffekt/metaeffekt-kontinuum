    <parent>
        <groupId>com.metaeffekt.kontinuum</groupId>
        <artifactId>ae-kontinuum-processors</artifactId>
        <version>KONTINUUM-SNAPSHOT</version>
        <relativePath>../_common_/ae-kontinuum-processors.xml</relativePath>
    </parent>

    <artifactId>util_aggregate-licenses</artifactId>
    <packaging>pom</packaging>

    <properties>
        <param.reference.inventory.includes>**/*.ser,**/*.xls,**/*.xlsx</param.reference.inventory.includes>
        <param.fail.on.missing.license.file>false</param.fail.on.missing.license.file>
        <param.fail.on.missing.component.files>false</param.fail.on.missing.component.files>
        <param.reference.components.dir>../components</param.reference.components.dir>
        <param.reference.licenses.dir>../licenses</param.reference.licenses.dir>
        <param.target.components.dir>${project.build.directory}/annex/components</param.target.components.dir>
        <param.target.licenses.dir>${project.build.directory}/annex/licenses</param.target.licenses.dir>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.metaeffekt.artifact.analysis</groupId>
                <artifactId>ae-artifact-analysis-plugin</artifactId>
                <version>${ae.artifact.analysis.version}</version>
                <executions>
                    <execution>
                        <id>aggregate-licenses-from-terms-metadata</id>
                        <goals>
                            <goal>aggregate-licenses</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <inventoryFile>${input.inventory.file}</inventoryFile>
                            <referenceInventoryDir>${param.reference.inventory.dir}</referenceInventoryDir>
                            <referenceInventoryIncludes>${param.reference.inventory.includes}</referenceInventoryIncludes>
                            <referenceComponentsDir>${param.reference.components.dir}</referenceComponentsDir>
                            <referenceLicensesDir>${param.reference.licenses.dir}</referenceLicensesDir>
                            <failOnMissingLicenseFile>${param.fail.on.missing.license.file}</failOnMissingLicenseFile>
                            <failOnMissingComponentFiles>${param.fail.on.missing.component.files}</failOnMissingComponentFiles>
                            <targetComponentsDir>${param.target.components.dir}</targetComponentsDir>
                            <targetLicensesDir>${param.target.licenses.dir}</targetLicensesDir>

                            <!-- We utilize the metaeffekt kosmos as our database for license information -->
                            <tmdGroupId>${ae.tmd.groupId}</tmdGroupId>
                            <tmdArtifactId>${ae.tmd.artifactId}</tmdArtifactId>
                            <tmdVersion>${ae.tmd.version}</tmdVersion>

                            <userPassword>${env.tmd.password}</userPassword>
                            <userKeysFile>${env.tmd.userkeys.file}</userKeysFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>  <!-- This plugin is only relevant to deliver better error messages to the caller of this pom. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-property</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireProperty>
                                    <property>input.inventory.file</property>
                                </requireProperty>
                                <requireProperty>
                                    <property>env.tmd.password</property>
                                </requireProperty>
                                <requireProperty>
                                    <property>env.tmd.userkeys.file</property>
                                </requireProperty>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>

        <profile>
            <id>kosmos</id>
            <activation>
                <property>
                    <name>env.tmd.source</name>
                    <value>ae-kosmos</value>
                </property>
            </activation>
            <properties>
                <ae.tmd.groupId>com.metaeffekt.kosmos</ae.tmd.groupId>
                <ae.tmd.artifactId>ae-metaeffekt-kosmos</ae.tmd.artifactId>
                <ae.tmd.version>${ae.kosmos.version}</ae.tmd.version>
            </properties>
        </profile>

        <profile>
            <id>universe</id>
            <activation>
                <property>
                    <name>env.tmd.source</name>
                    <value>ae-universe</value>
                </property>
            </activation>
            <properties>
                <ae.tmd.groupId>com.metaeffekt.universe</ae.tmd.groupId>
                <ae.tmd.artifactId>ae-metaeffekt-universe</ae.tmd.artifactId>
                <ae.tmd.version>${ae.universe.version}</ae.tmd.version>
            </properties>
        </profile>

    </profiles>
</project>
