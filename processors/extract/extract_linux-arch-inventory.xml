    <parent>
        <groupId>com.metaeffekt.kontinuum</groupId>
        <artifactId>ae-kontinuum-processors</artifactId>
        <version>KONTINUUM-SNAPSHOT</version>
        <relativePath>../_common_/ae-kontinuum-processors.xml</relativePath>
    </parent>

    <artifactId>extract_linux-arch-inventory</artifactId>
    <packaging>jar</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>org.metaeffekt.core</groupId>
                <artifactId>ae-inventory-maven-plugin</artifactId>
                <version>${ae.core.version}</version>
                <executions>
                    <execution>
                        <id>extract-container-inventory</id>
                        <goals>
                            <goal>extract-container-inventory</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <inputArchiveFile>${input.archive.file}</inputArchiveFile>
                            <targetInventoryFile>${output.inventory.file}</targetInventoryFile>
                            <analysisDir>${param.analysis.dir}</analysisDir>
                            <activateFileLevelProcessing>${param.activate.file.processing}</activateFileLevelProcessing>
                            <excludePatternsFile>${param.exclude.pattern.file}</excludePatternsFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-property</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireProperty>
                                    <property>input.archive.file</property>
                                </requireProperty>
                                <requireProperty>
                                    <property>param.analysis.dir</property>
                                </requireProperty>
                                <requireProperty>
                                    <property>output.inventory.file</property>
                                </requireProperty>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>kotlin-script</id>
            <activation>
                <property>
                    <name>param.kotlin.script.file</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.metaeffekt.artifact.analysis</groupId>
                        <artifactId>ae-kotlin-scripting-maven-plugin</artifactId>
                        <version>${ae.artifact.analysis.version}</version>
                        <executions>
                            <execution>
                                <id>script-extracted-inventory</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>execute-script</goal>
                                </goals>
                                <configuration>
                                    <kotlinScript>${param.kotlin.script.file}</kotlinScript>
                                    <parameterMap>
                                        <input.inventory.file>${output.inventory.file}</input.inventory.file>
                                        <output.inventory.dir>${output.scripted.inventory.dir}</output.inventory.dir>
                                    </parameterMap>
                                    <scriptExecutionClass>com.metaeffekt.artifact.analysis.scripting.kotlin.exec.InventoryScriptExecution</scriptExecutionClass>
                                </configuration>
                            </execution>
                        </executions>
                        <dependencies>
                            <dependency>
                                <groupId>com.metaeffekt.artifact.analysis</groupId>
                                <artifactId>ae-artifact-flow</artifactId>
                                <version>${ae.artifact.analysis.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>com.fasterxml.jackson.module</groupId>
                                <artifactId>jackson-module-kotlin</artifactId>
                                <version>2.22.0</version>
                                <exclusions>
                                    <!-- Exclude jackson's bundled kotlin so the ae-kotlin-scripting-host's
                                         kotlin (2.1.0) remains authoritative on the plugin classpath. -->
                                    <exclusion>
                                        <groupId>org.jetbrains.kotlin</groupId>
                                        <artifactId>kotlin-reflect</artifactId>
                                    </exclusion>
                                    <exclusion>
                                        <groupId>org.jetbrains.kotlin</groupId>
                                        <artifactId>kotlin-stdlib</artifactId>
                                    </exclusion>
                                    <exclusion>
                                        <groupId>org.jetbrains.kotlin</groupId>
                                        <artifactId>kotlin-stdlib-common</artifactId>
                                    </exclusion>
                                </exclusions>
                            </dependency>
                            <dependency>
                                <groupId>com.fasterxml.jackson.dataformat</groupId>
                                <artifactId>jackson-dataformat-yaml</artifactId>
                                <version>2.22.0</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>${maven.enforcer.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>enforce-kotlin-script-properties</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireProperty>
                                            <property>output.scripted.inventory.dir</property>
                                        </requireProperty>
                                    </rules>
                                    <fail>true</fail>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

