    <parent>
        <groupId>com.metaeffekt.kontinuum</groupId>
        <artifactId>ae-kontinuum-processors</artifactId>
        <version>KONTINUUM-SNAPSHOT</version>
        <relativePath>../_common_/ae-kontinuum-processors.xml</relativePath>
    </parent>

    <artifactId>fetch_download-asset</artifactId>
    <packaging>pom</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven.antrun.plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>ant-contrib</groupId>
                        <artifactId>ant-contrib</artifactId>
                        <version>1.0b3</version>
                        <exclusions>
                            <exclusion>
                                <groupId>ant</groupId>
                                <artifactId>ant</artifactId>
                            </exclusion>
                        </exclusions>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>download-asset</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${output.asset.dir}" />
                                <taskdef resource="net/sf/antcontrib/antlib.xml" />
                                <if>
                                    <isset property="param.username" />
                                    <then>
                                        <if>
                                            <isset property="param.password" />
                                            <then>
                                                <get src="${param.asset.url}" dest="${output.asset.dir}" verbose="true"
                                                     username="${param.username}" password="${param.password}" />
                                            </then>
                                            <elseif>
                                                <isset property="param.token" />
                                                <then>
                                                    <get src="${param.asset.url}" dest="${output.asset.dir}" verbose="true"
                                                         username="${param.username}" password="${param.token}" />
                                                </then>
                                            </elseif>
                                            <else>
                                                <get src="${param.asset.url}" dest="${output.asset.dir}" verbose="true"
                                                     username="${param.username}" password="" />
                                            </else>
                                        </if>
                                    </then>
                                    <elseif>
                                        <isset property="param.token" />
                                        <then>
                                            <if>
                                                <isset property="param.header.name" />
                                                <then>
                                                    <get src="${param.asset.url}" dest="${output.asset.dir}" verbose="true">
                                                        <header name="${param.header.name}" value="${param.token}" />
                                                    </get>
                                                </then>
                                                <else>
                                                    <get src="${param.asset.url}" dest="${output.asset.dir}" verbose="true">
                                                        <header name="Authorization" value="Bearer ${param.token}" />
                                                    </get>
                                                </else>
                                            </if>
                                        </then>
                                    </elseif>
                                    <elseif>
                                        <isset property="param.password" />
                                        <then>
                                            <get src="${param.asset.url}" dest="${output.asset.dir}" verbose="true" password="${param.password}" />
                                        </then>
                                    </elseif>
                                    <elseif>
                                        <isset property="param.header.name" />
                                        <then>
                                            <get src="${param.asset.url}" dest="${output.asset.dir}" verbose="true">
                                                <header name="${param.header.name}" value="${param.header.value}" />
                                            </get>
                                        </then>
                                    </elseif>
                                    <else>
                                        <get src="${param.asset.url}" dest="${output.asset.dir}" verbose="true" />
                                    </else>
                                </if>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-property</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireProperty>
                                    <property>param.asset.url</property>
                                </requireProperty>
                                <requireProperty>
                                    <property>output.asset.dir</property>
                                </requireProperty>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
